Algoritmo "EstruturasSequenciais_ex03"
  // Capítulo Estruturas Sequenciais "Soma"

Var

  x, y, soma : inteiro

Inicio

  escreva("Digite o valor de X: ")
  leia(x)
  escreva("Digite o valor de Y: ")
  leia(y)
  
  escreval()

  soma <- x + y
  escreva("A soma entre", x, " e", y, " é igual a", soma)

Fimalgoritmo