Algoritmo "EstruturasSequenciais_ex05"
  // Capítulo Estruturas Sequenciais "Círculo"

Var

  areaCirculo, raioCirculo : real

Inicio

  escreva("Digite o valor de raio do círculo: ")
  leia(raioCirculo)

  areaCirculo <- pi * Exp(raioCirculo, 2.0)

  escreva("A área do círculo é igual a ", areaCirculo:8:3)

Fimalgoritmo