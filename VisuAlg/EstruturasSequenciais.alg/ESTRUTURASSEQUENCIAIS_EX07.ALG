Algoritmo "EstruturasSequenciais_ex07"
// Capítulo Estruturas Sequenciais "Consumo"
Var

   distancia, combustivel, consumoMedio : real

Inicio

   escreva("Distância percorrida: ")
   leia(distancia)
   escreva("Combustível gasto: ")
   leia(combustivel)
   consumoMedio <- distancia / combustivel
   escreval("Consumo médio: ", consumoMedio:6:3)

Fimalgoritmo