Algoritmo "Senha Fixa"
// Problema "Senha fixa" - Estrutura Repetitiva Enquanto
Var

   senha : inteiro

Inicio

   senha <- 2002
   escreva("Digite sua senha: ")
   leia(senha)

   enquanto senha <> 2002 faca
      escreva("Senha incorreta! Tente novamente: ")
      leia(senha)
   fimenquanto
   
   se senha = 2002 entao
      escreval("Acesso permitido.")
   fimse
Fimalgoritmo